    given-names: Min-Yao
    affiliation: Donald Danforth Plant Science Center
    orcid: "https://orcid.org/0000-0002-8654-0977"
repository-code: "https://github.com/MinYaoJhu/MedicagoXeniumSpatialViewer"
license: MIT
keywords:
  - spatial transcriptomics
  - Xenium
  - Seurat
  - Shiny
  - single-cell
  - bioinformatics
  - Medicago truncatula
